// A public booking may use at most 20 document reads: one getAfter() per cell
// plus two for the visit. That caps a public visit at 180 minutes (18 cells).
// Deploy the website before these rules. Older site builds write cells without
// appointmentId, which these rules reject.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRoleDoc() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null && getRoleDoc().role == "admin";
    }
    function isStaff() {
      return request.auth != null
             && (getRoleDoc().role == "admin" || getRoleDoc().role == "doctor");
    }

    function isDateString(value) {
      return value is string
             && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function isCellTime(value) {
      return value is string
             && value.matches('^([01][0-9]|2[0-3]):[0-5]0$');
    }

    function toMins(hhmm) {
      return int(hhmm.split(':')[0]) * 60 + int(hhmm.split(':')[1]);
    }

    function isPublicSlotCell(slotId) {
      let cell = request.resource.data;
      return cell.keys().hasAll(['date', 'time', 'doctorId', 'duration', 'appointmentId'])
             && cell.keys().hasOnly(['date', 'time', 'doctorId', 'duration', 'appointmentId'])
             && cell.doctorId is string
             && cell.doctorId.size() > 0
             && isDateString(cell.date)
             && isCellTime(cell.time)
             && cell.duration == 10
             && slotId == cell.doctorId + '_' + cell.date + '_' + cell.time
             && cell.appointmentId is string
             && cell.appointmentId.size() > 0
             && isCellOfNewAppointment(cell,
                  getAfter(/databases/$(database)/documents/appointments/$(cell.appointmentId)).data);
    }
    function isCellOfNewAppointment(cell, appt) {
      return appt.createdAt == request.time
             && appt.doctorId == cell.doctorId
             && appt.date == cell.date
             && toMins(cell.time) >= toMins(appt.time)
             && toMins(cell.time) < toMins(appt.time) + appt.duration;
    }

    function isPublicAppointment() {
      return request.resource.data.keys().hasAll([
               'slotId', 'date', 'time', 'patientName', 'petName',
               'phone', 'email', 'service', 'duration', 'status', 'createdAt',
               'doctorId', 'doctorName'])
             && request.resource.data.keys().hasOnly([
               'slotId', 'date', 'time', 'patientName', 'petName',
               'phone', 'email', 'service', 'duration', 'status', 'createdAt',
               'doctorId', 'doctorName', 'comment'])
             && request.resource.data.status == 'pending'
             && request.resource.data.createdAt == request.time
             && isDateString(request.resource.data.date)
             && isCellTime(request.resource.data.time)
             && request.resource.data.patientName is string
             && request.resource.data.patientName.size() <= 100
             && request.resource.data.petName is string
             && request.resource.data.petName.size() <= 100
             && request.resource.data.phone is string
             && request.resource.data.phone.matches('^[0-9]{9}$')
             && request.resource.data.email is string
             && request.resource.data.email.size() <= 200
             && request.resource.data['service'] is string
             && request.resource.data['service'].size() <= 100
             && request.resource.data.doctorName is string
             && request.resource.data.doctorName.size() <= 200
             && request.resource.data.duration is number
             && request.resource.data.duration >= 5
             && request.resource.data.duration <= 180
             && (!('comment' in request.resource.data)
                 || (request.resource.data.comment is string
                     && request.resource.data.comment.size() <= 1000))
             && request.resource.data.doctorId is string
             && request.resource.data.doctorId.size() > 0
             && request.resource.data.doctorId.size() <= 100
             && request.resource.data.slotId == request.resource.data.doctorId + '_'
                                                + request.resource.data.date + '_'
                                                + request.resource.data.time
             && exists(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId))
             && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId));
    }

    match /roles/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /slots/{slotId} {
      allow read: if true;
      allow create: if isPublicSlotCell(slotId);
      allow create, update, delete: if isStaff();
    }

    match /appointments/{appointmentId} {
      allow read: if isStaff();
      allow create: if isPublicAppointment();
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly([
                           'status', 'notes', 'duration',
                           'patientName', 'petName', 'phone', 'email', 'service', 'time',
                           'date', 'comment'
                         ]);
      allow delete: if isStaff();
    }

    match /doctorSchedules/{doctorId} {
      allow read: if true;
      allow write: if isAdmin()
                   || (isStaff() && request.auth.uid == doctorId);
    }
  }
}
