// Slot-cell model: a booked visit occupies one `slots` document per 10-minute
// cell, with the id `doctorId_date_time` and duration 10, so two visitors can
// never take the same cell. The `appointments` document points at the first
// cell (slotId) and is created in the same transaction as the cells.
//
// Deploy order: publish the website first, then deploy these rules. The
// previous website build creates differently shaped slot docs, which these
// rules reject.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Role helpers (check roles collection) ──
    function getRoleDoc() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null && getRoleDoc().role == "admin";
    }
    function isStaff() {
      return request.auth != null
             && (getRoleDoc().role == "admin" || getRoleDoc().role == "doctor");
    }
    function canEditSite() {
      return request.auth != null
             && (getRoleDoc().role == "admin"
                 || (getRoleDoc().role == "doctor" && getRoleDoc().canEditWebsite == true));
    }

    // ── Format helpers ──
    // 'YYYY-MM-DD'
    function isDateString(value) {
      return value is string
             && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    // 'HH:MM'
    function isTimeString(value) {
      return value is string
             && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    // 'HH:MM' on the 10-minute grid
    function isCellTime(value) {
      return value is string
             && value.matches('^([01][0-9]|2[0-3]):[0-5]0$');
    }

    // ── Public booking: one 10-minute cell ──
    // No get()/exists() here on purpose — one booking creates many cells in a
    // single transaction and document-access calls are limited per request.
    function isPublicSlotCell(slotId) {
      return request.resource.data.keys().hasAll(['date', 'time', 'doctorId', 'duration'])
             && request.resource.data.keys().hasOnly(['date', 'time', 'doctorId', 'duration'])
             && request.resource.data.doctorId is string
             && request.resource.data.doctorId.size() > 0
             && isDateString(request.resource.data.date)
             && isCellTime(request.resource.data.time)
             && request.resource.data.duration == 10
             && slotId == request.resource.data.doctorId + '_'
                          + request.resource.data.date + '_'
                          + request.resource.data.time;
    }

    // ── Public booking: the appointment ──
    function isPublicAppointment() {
      return request.resource.data.keys().hasAll([
               'slotId', 'date', 'time', 'patientName', 'petName',
               'phone', 'email', 'service', 'duration', 'status', 'createdAt',
               'doctorId', 'doctorName'])
             && request.resource.data.keys().hasOnly([
               'slotId', 'date', 'time', 'patientName', 'petName',
               'phone', 'email', 'service', 'duration', 'status', 'createdAt',
               'doctorId', 'doctorName', 'comment'])
             && request.resource.data.status == 'pending'
             && request.resource.data.createdAt == request.time
             && isDateString(request.resource.data.date)
             && isTimeString(request.resource.data.time)
             && request.resource.data.patientName is string
             && request.resource.data.patientName.size() <= 100
             && request.resource.data.petName is string
             && request.resource.data.petName.size() <= 100
             && request.resource.data.phone is string
             && request.resource.data.phone.matches('^[0-9]{9}$')
             && request.resource.data.email is string
             && request.resource.data.email.size() <= 200
             && request.resource.data.service is string
             && request.resource.data.service.size() <= 100
             && request.resource.data.doctorName is string
             && request.resource.data.doctorName.size() <= 200
             && request.resource.data.duration is number
             && request.resource.data.duration >= 5
             && request.resource.data.duration <= 480
             && (!('comment' in request.resource.data)
                 || (request.resource.data.comment is string
                     && request.resource.data.comment.size() <= 1000))
             && request.resource.data.doctorId is string
             && request.resource.data.doctorId.size() > 0
             && request.resource.data.doctorId.size() <= 100
             && request.resource.data.slotId is string
             && request.resource.data.slotId.size() > 0
             && request.resource.data.slotId.size() <= 200
             && exists(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId))
             // The first cell must be created by this very transaction (free
             // before it, taken after it) for the same doctor and day.
             && !exists(/databases/$(database)/documents/slots/$(request.resource.data.slotId))
             && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId))
             && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.doctorId
                == request.resource.data.doctorId
             && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.date
                == request.resource.data.date;
    }

    // ── Roles (only admins can manage; everyone reads their own at login) ──
    match /roles/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Doctors ──
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Slots ──
    match /slots/{slotId} {
      allow read: if true;
      // Public booking page: only well-formed 10-minute cells
      allow create: if isPublicSlotCell(slotId);
      // Staff: unrestricted (also restores legacy-shaped docs)
      allow create, update, delete: if isStaff();
    }

    // ── Appointments ──
    match /appointments/{appointmentId} {
      allow read: if isStaff();
      allow create: if isPublicAppointment();
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly([
                           'status', 'notes', 'duration',
                           'patientName', 'petName', 'phone', 'email', 'service', 'time',
                           'date', 'comment'
                         ]);
      allow delete: if isStaff();
    }

    // ── Schedule (clinic-wide overrides) ──
    match /schedule/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Doctor Schedules ──
    match /doctorSchedules/{doctorId} {
      allow read: if true;
      allow write: if isAdmin()
                   || (isStaff() && request.auth.uid == doctorId);
    }

    // ── Site Content ──
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if canEditSite();
    }

    // ── Services ──
    match /services/{serviceId} {
      allow read: if true;
      allow write: if canEditSite();
    }

    // ── Site Errors ──
    match /siteErrors/{errorId} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasAll(['timestamp', 'page', 'error'])
                    && request.resource.data.keys().hasOnly(['timestamp', 'page', 'error'])
                    && request.resource.data.timestamp == request.time
                    && request.resource.data.page is string
                    && request.resource.data.page.size() <= 50
                    && request.resource.data.error is string
                    && request.resource.data.error.size() <= 2000;
      allow delete: if isStaff();
    }
  }
}
